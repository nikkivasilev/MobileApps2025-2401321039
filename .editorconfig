root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# Composables are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wrapping at every operator splits short conditions like `if (count > 1)` over three lines.
ktlint_standard_binary-expression-wrapping = disabled
